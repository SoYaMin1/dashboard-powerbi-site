# Скопируйте этот файл в .env и заполните значения
SECRET_KEY=замените-на-случайную-строку
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Если не задан, используется SQLite
# DATABASE_URL=postgres://user:password@localhost:5432/adventureworks

# Безопасность при DEBUG=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600

# Резервные ссылки Power BI (Publish to web)
POWERBI_SALES_URL=
POWERBI_MAP_URL=